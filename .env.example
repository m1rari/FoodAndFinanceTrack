# Домен для TLS (Caddy). Для локального запуска можно оставить localhost.
DOMAIN=localhost

# Токен Telegram-бота (валидация initData). Получить у @BotFather.
BOT_TOKEN=

# Ключ OpenCode Go API (AI-анализ). На Этапе 1 не обязателен.
OPENCODE_GO_KEY=

# Пароль пользователя app в PostgreSQL. Обязательно сменить!
DB_PASSWORD=change-me

# Время жизни initData (TimeSpan). По умолчанию 24 часа.
INIT_DATA_TTL=24:00:00
