# Домен для TLS (Caddy). Для локального запуска можно оставить localhost.
DOMAIN=localhost

# Токен Telegram-бота (валидация initData). Получить у @BotFather.
BOT_TOKEN=

# Ключ OpenCode Go API (AI-анализ чеков). Если пусто — AI отключён, чек уходит на ручной разбор.
OPENCODE_GO_KEY=

# Vision-модель OpenCode Go и порог уверенности (ниже — статус "требует проверки").
AI_MODEL=deepseek-v4-flash-vision-exp
AI_TEXT_MODEL=deepseek-v4.1-flash
AI_CONFIDENCE_THRESHOLD=0.6

# Пароль пользователя app в PostgreSQL. Обязательно сменить!
DB_PASSWORD=change-me

# Время жизни initData (TimeSpan). По умолчанию 24 часа.
INIT_DATA_TTL=24:00:00

# Публичный адрес приложения без слэша — нужен для регистрации webhook бота.
PUBLIC_BASE_URL=https://example.com

# Секрет webhook бота (X-Telegram-Bot-Api-Secret-Token). Любая случайная строка.
TELEGRAM_WEBHOOK_SECRET=
